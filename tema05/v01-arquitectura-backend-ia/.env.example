PORT=3000
CORS_ORIGIN=http://localhost:4200

ANTHROPIC_API_KEY=REEMPLAZA_CON_TU_API_KEY
ANTHROPIC_MODEL=REEMPLAZA_CON_EL_MODELO_HABILITADO

MAX_HISTORY_MESSAGES=8
SESSION_TTL_MINUTES=30
MAX_USER_MESSAGE_LENGTH=4000
MAX_CONTEXT_MESSAGES=8
CLAUDE_MAX_TOKENS=600
CLAUDE_TEMPERATURE=0.3
AI_TIMEOUT_MS=30000

INTERACTION_LOG_DIR=logs
INTERACTION_LOG_FILE=assistant-interactions.jsonl
INTERACTION_LOG_CONSOLE=true
