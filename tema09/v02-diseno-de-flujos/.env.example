# Copia a .env. El modo mock permite ejecutar el laboratorio sin llamadas al modelo.
AI_MODE=mock
PORT=3000
HOST=127.0.0.1
# AI_MODE=claude usa esta clave o ANTHROPIC_API_KEY.
COURSE_ANTHROPIC_API_KEY=
CLAUDE_MODEL=claude-sonnet-4-6
CLAUDE_EFFORT=medium
CLAUDE_THINKING=adaptive
CLAUDE_MAX_TOKENS=4096
AUDIT_FILE=logs/automation-audit.jsonl
# Solo v10: nombres separados por coma, por ejemplo assign_owner,stale_ticket_followup
DISABLED_ACTIONS=
