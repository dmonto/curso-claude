# Todo es local y simulado por defecto. Cambia a false para usar Claude.
MOCK_CLAUDE=true
ANTHROPIC_API_KEY=
# También se admite COURSE_ANTHROPIC_API_KEY desde .env o PowerShell.
ANTHROPIC_MODEL=claude-sonnet-4-6
CLAUDE_EFFORT=medium
CLAUDE_THINKING=adaptive
CLAUDE_MAX_TOKENS=4096
MODEL_TIMEOUT_MS=60000
MAX_MODEL_ROUNDS=5
MAX_TOOL_CALLS=8

GATEWAY_PORT=3000
ORDERS_PORT=4001
CUSTOMERS_PORT=4002
BILLING_PORT=4003
TICKETS_PORT=4004
ORDERS_SERVICE_URL=http://127.0.0.1:4001
CUSTOMERS_SERVICE_URL=http://127.0.0.1:4002
BILLING_SERVICE_URL=http://127.0.0.1:4003
TICKETS_SERVICE_URL=http://127.0.0.1:4004
INTERNAL_TOKEN=curso-local-internal-token-change-me
JWT_SECRET=curso-local-jwt-secret-change-me-at-least-32-characters
ACCESS_TOKEN_TTL=30m
ACTION_TTL_MS=300000
SERVICE_TIMEOUT_MS=1200
TOOL_TIMEOUT_MS=3500
CUSTOMER_CACHE_TTL_MS=60000
FRONTEND_ORIGINS=http://localhost:4200,http://127.0.0.1:4200

# Solo para ejercicios de errores. Habilitar explícitamente.
ALLOW_CHAOS=false
CHAOS_SERVICE=none
CHAOS_MODE=none
# all, GET o POST. POST permite fallar la escritura sin impedir su preparación.
CHAOS_OPERATION=all
