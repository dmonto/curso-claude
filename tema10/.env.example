# Configuración común del tema 10. Copia este .env a la versión que ejecutes.
# No copies claves al frontend Angular.
PORT=3000
MODEL_MODE=mock
COURSE_ANTHROPIC_API_KEY=
# También se acepta ANTHROPIC_API_KEY.
CLAUDE_MODEL=claude-sonnet-4-6
CLAUDE_EFFORT=medium
CLAUDE_THINKING=adaptive
CLAUDE_MAX_TOKENS=4096
MAX_AGENT_ITERATIONS=10
MAX_TOOL_CALLS=16
MODEL_TIMEOUT_MS=45000
INTERNAL_API_TIMEOUT_MS=5000
ACTION_TTL_SECONDS=600
SESSION_TTL_SECONDS=1800
DATA_DIR=data/runtime
LOG_DIR=logs
# Opcional: credencial de la API interna, solo en el backend.
# Si queda vacía, se genera una aleatoria al iniciar.
INTERNAL_API_TOKEN=
# Para ensayar un fallo: get_shipping_status o send_internal_notification.
DEMO_FAIL_TOOL=
